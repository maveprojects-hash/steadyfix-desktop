{
  "name": "steadyfix-desktop",
  "productName": "STEADYFIX CMMS",
  "version": "1.0.3",
  "description": "STEADYFIX CMMS for computers (PRO plan)",
  "homepage": "https://maveprojects-hash.github.io/steadyfix/",
  "main": "main.js",
  "author": {
    "name": "Maverick's Projects",
    "email": "support@steadyfixcmms.com"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.0.0"
  },
  "devDependencies": {
    "electron": ">=40.0.0",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.maverickprojects.steadyfix",
    "productName": "STEADYFIX CMMS",
    "files": [
      "main.js",
      "gateway.js",
      "package.json",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "Office"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "maveprojects-hash",
        "repo": "steadyfix-desktop"
      }
    ]
  }
}
